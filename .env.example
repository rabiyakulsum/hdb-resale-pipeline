# Copy this file to .env and edit it:   cp .env.example .env
#
# .env is gitignored - it is yours, and it is the only place a password
# should ever appear. This file is committed, so keep it free of real
# credentials: it exists to document which keys the project reads.
#
# Every key here is optional. Leave it out and the default (shown as the
# local value below) applies.

# --- MongoDB ---------------------------------------------------------------
# Local mongod:
MONGO_URI=mongodb://localhost:27017

# MongoDB Atlas instead - paste the string from
# Atlas > Cluster > Connect > Drivers, and replace <username>/<password>:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# Two things that catch people out with Atlas:
#   1. Your IP must be allowed under Network Access, or every call times out.
#   2. If your password contains @ : / or ?, percent-encode it
#      (@ becomes %40), otherwise the URL parses wrongly.

MONGO_DB=hdb_demo
MONGO_COLLECTION=resale_flats

# --- Redis -----------------------------------------------------------------
# Local redis:
REDIS_URL=redis://localhost:6379

# Redis Cloud instead. Note rediss:// with two s - that is TLS, not a typo:
# REDIS_URL=rediss://default:<password>@<host>.<region>.redns.redis-cloud.com:<port>
#
# WHERE TO GET THIS. Redis Cloud has two completely different credentials and
# only one of them connects a client:
#
#   Databases > your database > Connect
#       -> public endpoint (host:port) and the database password.
#          THIS is what REDIS_URL needs.
#
#   Access Management > API Keys
#       -> an account key and a secret key, used to CREATE and manage
#          databases through api.redislabs.com. These will NOT authenticate a
#          Redis connection. Nothing in this project uses them.

# How long a cached answer stays valid, in seconds. Deliberately short: Step 4
# demonstrates a cache entry EXPIRING, which needs a TTL you can wait out.
CACHE_TTL_SECONDS=60

# TTL for the queries the dashboard needs but does not teach with - the town
# list, the dataset summary, a page of rows. The dataset is a static file, so
# these cannot go stale during a class.
STATIC_TTL_SECONDS=900

# --- Our API ---------------------------------------------------------------
# 5000 is taken by AirPlay Receiver on macOS, hence 5001.
API_PORT=5001
