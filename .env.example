# Copy this file to .env and edit it:   cp .env.example .env
#
# .env is gitignored - it is yours, and it is the only place a password
# should ever appear. This file is committed, so keep it free of real
# credentials: it exists to document which keys the project reads.
#
# Every key here is optional. Leave it out and the default (shown as the
# local value below) applies.

# --- MongoDB ---------------------------------------------------------------
# Local mongod:
MONGO_URI=mongodb://localhost:27017

# MongoDB Atlas instead - paste the string from
# Atlas > Cluster > Connect > Drivers, and replace <username>/<password>:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# Two things that catch people out with Atlas:
#   1. Your IP must be allowed under Network Access, or every call times out.
#   2. If your password contains @ : / or ?, percent-encode it
#      (@ becomes %40), otherwise the URL parses wrongly.

MONGO_DB=hdb_demo
MONGO_COLLECTION=resale_flats

# --- Redis -----------------------------------------------------------------
# Local redis:
REDIS_URL=redis://localhost:6379

# Hosted Redis (Redis Cloud, Upstash, ...). Note rediss:// with two s for TLS:
# REDIS_URL=rediss://default:<password>@<host>:<port>

# How long a cached answer stays valid, in seconds.
CACHE_TTL_SECONDS=60

# --- Our API ---------------------------------------------------------------
# 5000 is taken by AirPlay Receiver on macOS, hence 5001.
API_PORT=5001
